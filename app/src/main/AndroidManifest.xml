<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.tencent.mm" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:name="com.paifa.univerge.app.UniVergeApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UniVerge">

        <activity android:name="com.paifa.univerge.app.SideFunctionsActivity" android:exported="false" />
        <activity
            android:name="com.paifa.univerge.app.OpenApiWorkbenchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge" />
        <activity
            android:name="com.paifa.univerge.accessibility.FinderPublishActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge" />
        <activity
            android:name="com.paifa.univerge.accessibility.FavoriteLibraryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />
        <activity
            android:name="com.paifa.univerge.app.MaterialLibraryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge" />
        <activity android:name="com.paifa.univerge.app.AccessibilityKeepAliveGuideActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.PauseSettingsActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.BlockedAppsActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.WeChatServiceActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.TouchTestActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.WeChatChatAppearanceActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.EdgeStyleSettingsActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.EdgeFunctionSettingsActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.GlobalControlsActivity" android:exported="false" />
        <activity android:name="com.paifa.univerge.app.TransferFlowActivity" android:excludeFromRecents="true" android:exported="false" android:taskAffinity="com.paifa.univerge.floatingchat" android:theme="@style/Theme.UniVerge" />
        <activity android:name="com.paifa.univerge.app.RedPacketActivity" android:excludeFromRecents="true" android:exported="false" android:taskAffinity="com.paifa.univerge.floatingchat" android:theme="@style/Theme.UniVerge" />
        <activity
            android:name="com.paifa.univerge.app.CouponWalletActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge" />
        <activity
            android:name="com.paifa.univerge.app.BackgroundRemovalActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge" />
        <activity
            android:name="com.paifa.univerge.app.FriendManagementActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge" />
        <activity
            android:name="com.paifa.univerge.app.ContactRelationsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge" />

        <activity
            android:name="com.paifa.univerge.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UniVerge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.paifa.univerge.app.FloatingChatMediaPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatDocumentPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatDocumentViewerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatCameraActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.MediaPreview" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatPhotoCameraPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatBlinkVoiceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.FloatingBlinkVoice" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatBlinkCameraPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatVoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatLocationPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.Transparent" />

        <activity
            android:name="com.paifa.univerge.app.FloatingChatMediaPreviewActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:taskAffinity="com.paifa.univerge.floatingchat"
            android:theme="@style/Theme.UniVerge.MediaPreview" />

        <service
            android:name="com.paifa.univerge.accessibility.UniVergeAccessibilityService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/ubiki_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ubiki_accessibility_service" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_edge_gesture_accessibility_overlay" />
        </service>

        <receiver
            android:name="com.paifa.univerge.app.GesturePersistenceReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.paifa.univerge.action.RECOVER_GESTURE" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.paifa.univerge.accessibility.UniVergeGestureKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent_edge_gesture_keep_alive" />
        </service>

        <service
            android:name="com.paifa.univerge.app.UniVergeQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_edge"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

    </application>
</manifest>
